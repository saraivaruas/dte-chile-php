{
    "name": "saraivaruas/dte-chile",
    "description": "Librería PHP de facturación electrónica para Chile (alto nivel): emite facturas, boletas, guías y notas al SII. Sin dependencias, MIT.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "chile",
        "sii",
        "dte",
        "libreria",
        "facturacion-electronica",
        "factura-electronica",
        "boleta-electronica",
        "e-invoicing",
        "xmldsig",
        "timbre",
        "caf"
    ],
    "homepage": "https://github.com/saraivaruas/dte-chile",
    "authors": [
        {
            "name": "Jorge Luis Saraiva Ruas",
            "homepage": "https://github.com/saraivaruas"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*"
    },
    "autoload": {
        "psr-4": {
            "IngeInnova\\DteChile\\": "php/src/"
        }
    },
    "scripts": {
        "test": "php php/tests/run.php"
    }
}
